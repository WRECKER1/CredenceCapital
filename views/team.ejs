<%- include('partials/top') %>
<% const groups = ['Faculty Advisor', 'Core Team', 'Associate', 'Alumni']; %>
<%- include('partials/page-head', { eyebrow: 'People', heading: 'The *team*', lead: 'The students and faculty who run Credence Capital.' }) %>
<% groups.forEach(g => { const list = (c.team || []).filter(m => m.group === g); if (!list.length) return; %>
<section class="section section-compact">
  <div class="wrap">
    <h2 class="h3"><%= g === 'Faculty Advisor' && list.length > 1 ? 'Faculty Advisors' : g %></h2>
    <div class="people">
      <% list.forEach(m => { %>
        <div class="person reveal">
          <% if (m.photo) { %><img src="<%= m.photo %>" alt="<%= m.name %>" loading="lazy"><% } else { %><span class="avatar"><%= h.initials(m.name) %></span><% } %>
          <div>
            <h3><%= m.name %></h3>
            <p><%= m.role %></p>
            <% if (m.batch) { %><p class="muted small"><%= m.batch %></p><% } %>
            <div class="person-links">
              <% if (m.linkedin) { %><a href="<%= m.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn">in</a><% } %>
              <% if (m.email) { %><a href="mailto:<%= m.email %>" aria-label="Email">@</a><% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% }) %>
<%- include('partials/bottom') %>
