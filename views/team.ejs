<%- include('partials/top') %>
<% const groups = ['Credence Team', 'Faculty Advisor', 'Alumni']; %>
<%- include('partials/page-head', { eyebrow: 'People', heading: 'The Credence team', lead: 'Each batch, a small group of IIM Lucknow students is chosen through a rigorous internal selection process to manage the fund. Senior members mentor them, and the faculty advise.' }) %>
<% groups.forEach(g => { const all = (c.team || []).filter(m => m.group === g); if (!all.length) return; const batches = [...new Set(all.map(m => m.batch || ''))]; const compact = g === 'Alumni'; %>
  <% batches.forEach(bt => { const list = all.filter(m => (m.batch || '') === bt); %>
  <section class="section section-compact">
    <div class="wrap">
      <p class="eyebrow"><%= g === 'Faculty Advisor' && list.length > 1 ? 'Faculty Advisors' : g %><% if (bt) { %> · <%= bt %><% } %></p>
      <div class="people <%= g === 'Credence Team' ? 'people-photos' : (compact ? '' : 'people-full') %>">
        <% list.forEach(m => { %>
          <div class="card person reveal">
            <div class="person-top">
              <% if (m.photo) { %><img src="<%= m.photo %>" alt="<%= m.name %>" loading="lazy"><% } else { %><span class="avatar"><%= h.initials(m.name) %></span><% } %>
              <div>
                <h3><%= m.name %></h3>
                <p><%= m.role %></p>
                <% if (m.internship) { %><p class="mono-label"><%= m.internship %></p><% } %>
                <% if (m.linkedin || m.email) { %><div class="person-links">
                  <% if (m.linkedin) { %><a href="<%= m.linkedin %>" target="_blank" rel="noopener" aria-label="<%= m.name %> on LinkedIn">in</a><% } %>
                  <% if (m.email) { %><a href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>">@</a><% } %>
                </div><% } %>
              </div>
            </div>
            <% if (m.bio && !compact) { %><p class="person-bio"><%= m.bio %></p><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% }) %>
<% }) %>
<%- include('partials/bottom') %>
