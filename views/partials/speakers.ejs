<div class="speakers">
  <% const want = typeof scope !== 'undefined' ? scope : 'Credence Capital'; (c.speakers || []).filter(sp => (sp.scope || 'Credence Capital') === want).forEach(sp => { %>
    <div class="speaker reveal">
      <% if (sp.photo) { %><img src="<%= sp.photo %>" alt="<%= sp.name %>" loading="lazy"><% } else { %><span class="avatar"><%= h.initials(sp.name) %></span><% } %>
      <div><strong><%= sp.name %></strong><span><%= [sp.title, sp.org].filter(Boolean).join(', ') %></span></div>
      <% if (sp.event) { %><span class="mono-label speaker-event"><%= sp.event %></span><% } %>
    </div>
  <% }) %>
</div>
