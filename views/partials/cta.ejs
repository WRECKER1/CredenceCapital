<section class="cta">
  <div class="wrap cta-inner">
    <div>
      <h2><%= title %></h2>
      <p><%= body %></p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-gold" href="/partner#enquire">Request a proposal</a>
      <% if (s.sponsorDeck) { %><a class="btn btn-ghost" href="<%= s.sponsorDeck %>" target="_blank" rel="noopener">Download deck</a>
      <% } else if (s.sponsorEmail || s.email) { %><a class="btn btn-ghost" href="mailto:<%= s.sponsorEmail || s.email %>">Email us</a><% } %>
    </div>
  </div>
</section>
