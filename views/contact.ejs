<%- include('partials/top') %>
<%- include('partials/page-head', { eyebrow: 'Contact', heading: 'Get in touch', lead: 'Questions about the club, our events or research? We would love to hear from you.' }) %>
<section class="section section-first">
  <div class="wrap split split-form">
    <div class="contact-info">
      <% if (s.email) { %><div><span class="mono-label">General</span><a class="link" href="mailto:<%= s.email %>"><%= s.email %></a></div><% } %>
      <% if (s.sponsorEmail && s.sponsorEmail !== s.email) { %><div><span class="mono-label">Partnerships</span><a class="link" href="mailto:<%= s.sponsorEmail %>"><%= s.sponsorEmail %></a></div><% } %>
      <% if (s.phone) { %><div><span class="mono-label">Phone</span><a class="link" href="tel:<%= s.phone.replace(/\s/g,'') %>"><%= s.phone %></a></div><% } %>
      <% if (s.address) { %><div><span class="mono-label">Visit us</span><p><%- h.esc(s.address).replace(/\n/g, '<br>') %></p></div><% } %>
      <div class="panel callout-small"><p><strong>Looking to sponsor?</strong> The partnership form gets a faster, tailored response.</p><a class="link" href="/partner#enquire">Partnership enquiry →</a></div>
    </div>
    <%- include('partials/enquiry', { type: 'contact', heading: 'Send a message' }) %>
  </div>
</section>
<%- include('partials/bottom') %>
